# verify.ys -- functional verification with Yosys SAT (formal, exhaustive)
#
# Part 1: combinational equivalence of the ALU against expected values.
#         Every free input is constrained with -set, so the SAT solver proves
#         the property for ALL possible remaining input combinations.
read_verilog rtl/alu.v
prep -top alu

sat -verify -prove y 8'd5    -set a 8'd2   -set b 8'd3 -set op 3'd0   # ADD 2+3
sat -verify -prove y 8'd255  -set a 8'd2   -set b 8'd3 -set op 3'd1   # SUB 2-3 (wrap)
sat -verify -prove y 8'h02   -set a 8'h0A  -set b 8'h03 -set op 3'd2  # AND
sat -verify -prove y 8'h0B   -set a 8'h0A  -set b 8'h03 -set op 3'd3  # OR
sat -verify -prove y 8'h09   -set a 8'h0A  -set b 8'h03 -set op 3'd4  # XOR
sat -verify -prove y 8'd8    -set a 8'd1   -set b 8'd3 -set op 3'd5   # SHL 1<<3
sat -verify -prove y 8'h08   -set a 8'h80  -set b 8'd4 -set op 3'd6   # SHR 0x80>>4
sat -verify -prove y 8'd0    -set a 8'hFF  -set b 8'hFF -set op 3'd7  # NOP

# Part 2: bounded model checking of the counter (2 clock edges).
design -reset
read_verilog rtl/counter.v
prep -top counter
async2sync   # SAT cannot model async FFs directly; makes reset synchronous

# count up: 0x00 -> 0x01   (inputs must be constrained at both time steps,
# because Yosys evaluates the next state from the state at t and the inputs at t+1)
sat -seq 2 -verify -prove-skip 1 \
    -set-at 1 rst_n 1 -set-at 1 ld 0 -set-at 1 en 1 -set-at 1 up 1 -set-at 1 q 8'h00 \
    -set-at 2 rst_n 1 -set-at 2 ld 0 -set-at 2 en 1 -set-at 2 up 1 \
    -prove q 8'h01
# count down: 0x01 -> 0x00
sat -seq 2 -verify -prove-skip 1 \
    -set-at 1 rst_n 1 -set-at 1 ld 0 -set-at 1 en 1 -set-at 1 up 0 -set-at 1 q 8'h01 \
    -set-at 2 rst_n 1 -set-at 2 ld 0 -set-at 2 en 1 -set-at 2 up 0 \
    -prove q 8'h00
# synchronous load has priority over count
sat -seq 2 -verify -prove-skip 1 \
    -set-at 1 rst_n 1 -set-at 1 ld 1 -set-at 1 load 8'hA5 -set-at 1 en 1 -set-at 1 up 1 -set-at 1 q 8'h00 \
    -set-at 2 rst_n 1 -set-at 2 ld 1 -set-at 2 load 8'hA5 -set-at 2 en 1 -set-at 2 up 1 \
    -prove q 8'hA5
